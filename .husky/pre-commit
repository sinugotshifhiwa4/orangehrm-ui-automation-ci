#!/usr/bin/env sh
set -e

echo "Running pre-commit checks..."
echo ""

# Get staged TypeScript and JavaScript files (Added, Copied, Modified only)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.js')

if [ -z "$STAGED_FILES" ]; then
  echo "No staged JS/TS files to check."
  echo ""
  exit 0
fi

HAS_ERROR=0

# ─── Focused tests (.only) ────────────────────────────────────────────────────
echo "Checking for focused tests (.only)..."

for file in $STAGED_FILES; do
  if git show ":$file" | grep -E -q '\.[[:space:]]*only[[:space:]]*\('; then
    echo ""
    echo "Focused test detected in staged file:"
    echo "   $file"
    echo ""
    git show ":$file" | grep -E -n '\.[[:space:]]*only[[:space:]]*\('
    echo ""
    HAS_ERROR=1
  fi
done

# ─── Skipped tests (.skip) ────────────────────────────────────────────────────
echo "Checking for skipped tests (.skip)..."

for file in $STAGED_FILES; do
  if git show ":$file" | grep -E -q '\.[[:space:]]*skip[[:space:]]*\('; then
    echo ""
    echo "Skipped test detected in staged file:"
    echo "   $file"
    echo ""
    git show ":$file" | grep -E -n '\.[[:space:]]*skip[[:space:]]*\('
    echo ""
    HAS_ERROR=1
  fi
done

# ─── ESLint disable comments (playwright rules) ───────────────────────────────
echo "Checking for eslint-disable comments on playwright rules..."

for file in $STAGED_FILES; do
  if git show ":$file" | grep -E -q '//[[:space:]]*eslint-disable(-next-line|-line)?[[:space:]].*playwright/'; then
    echo ""
    echo "Playwright ESLint disable comment detected in staged file:"
    echo "   $file"
    echo ""
    git show ":$file" | grep -E -n '//[[:space:]]*eslint-disable(-next-line|-line)?[[:space:]].*playwright/'
    echo ""
    HAS_ERROR=1
  fi
done

# ─── Block console.log ────────────────────────────────────────────────────────
echo "Checking for console.log statements..."

for file in $STAGED_FILES; do
  if git show ":$file" | grep -q 'console\.log'; then
    echo ""
    echo "console.log detected in staged file:"
    echo "   $file"
    echo ""
    git show ":$file" | grep -n 'console\.log'
    echo ""
    HAS_ERROR=1
  fi
done

if [ "$HAS_ERROR" -eq 1 ]; then
  echo "──────────────────────────────────────────────────"
  echo "Pre-commit checks FAILED. Please fix the above issues:"
  echo "  • Remove .only() from tests"
  echo "  • Remove .skip() from tests"
  echo "  • Remove eslint-disable comments for playwright rules"
  echo "  • Use the winston logger instead of console.log"
  echo "──────────────────────────────────────────────────"
  echo ""
  exit 1
fi

echo "No issues found."
echo ""

# ─── Run lint-staged ──────────────────────────────────────────────────────────
echo "Running lint-staged..."
npx lint-staged

echo ""
echo "All pre-commit checks passed! Proceeding with commit..."
echo ""